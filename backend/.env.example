# Backend Environment Configuration
PROJECT_NAME="Campus OD"
TAGLINE="Smart On-Duty Management System"
INSTITUTION="Sri Krishna Arts and Science College (SKASC)"
ENVIRONMENT="development"
DEBUG=true

# Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
# Driver: pg8000 (pure-Python, no C extensions — Windows Application Control compatible)
# Format: postgresql+pg8000://username:password@hostname:port/database_name
# Supabase Session Pooler example:
#   postgresql+pg8000://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+pg8000://postgres:postgres@localhost:5432/campus_od"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# File Storage Configuration
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
